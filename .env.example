# Copy this file to ".env" and fill in the real value.
# Never commit the real ".env" file (it's already in .gitignore).

# API key from your Resend account (Resend > API Keys). Needed to actually send emails.
RESEND_API_KEY=

# The "from" address alerts are sent from. Only works once the domain below
# is verified in Resend (adding a couple of DNS records with your domain admin).
# Until then, sending falls back to Resend's shared test domain automatically.
ALERT_FROM_ADDRESS=PRTracker <prtracker@placecomms.com>

# Fallback sender while the placecomms.com domain isn't verified yet:
# a personal Gmail account sending via an "app password" (myaccount.google.com/apppasswords).
GMAIL_SENDER_ADDRESS=yaakoubantony@gmail.com
GMAIL_APP_PASSWORD=
